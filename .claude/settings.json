{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/guard-worktree.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/enforce-pr-skill.sh" },
          { "type": "command", "command": ".claude/hooks/guard-pr-merge.sh" },
          { "type": "command", "command": ".claude/hooks/enforce-build.sh", "timeout": 600 }
        ]
      }
    ]
  }
}
